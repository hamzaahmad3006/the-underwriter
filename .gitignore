# --- secrets — never commit (SEC-005, OPS-030 secret scan) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- python ---
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
dist/
build/

# --- database (DB-*: lives on the persistent volume, never in git) ---
backend/data/
*.db
*.db-wal
*.db-shm

# --- node ---
node_modules/
frontend/dist/
*.local

# --- editors / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- vendored tools ---
# The Alpaca CLI ships as a GitHub release archive rather than a package, so
# `make tools` fetches it. A 9.5MB binary does not belong in the history.
backend/.tools/
