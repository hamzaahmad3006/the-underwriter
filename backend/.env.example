# SRS §30 — Environment Variables. Copy to .env and fill in. NEVER commit .env.

# --- Alpaca (paper only) ---------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true            # SEC-004: app refuses to boot if not "true"
ALPACA_DATA_API_KEY=               # optional read-only data key (ALP-004)
ALPACA_DATA_SECRET_KEY=
ALPACA_TOOLSETS=                   # MCP allowlist (MCP-006)
ALPACA_ALLOW_TEST_ORDER=false      # true only when running the ALP-003 probe order

# --- Kernel & operator -----------------------------------------------------
KERNEL_SIGNING_SECRET=             # >=32 random bytes, HMAC for verdicts (SEC-005)
OPERATOR_TOKEN=                    # >=32 chars, dashboard write auth (SEC-018)

# --- LLM (Groq, TD-13) -----------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b     # must support json_schema — verify (ASM-006)
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Platform --------------------------------------------------------------
DATABASE_URL=sqlite:///data/underwriter.db
CORS_ORIGINS=http://localhost:5173 # no wildcards in prod (SEC-007)
ALERT_WEBHOOK_URL=                 # Discord/Slack (OPS-009)
LOG_LEVEL=INFO
ENVIRONMENT=local                  # local | production
APP_VERSION=dev                    # git SHA, injected at build
